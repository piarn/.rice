#!/usr/bin/env python3
"""Spiral tiling for sway: whenever a tiled window gets focus, set the
direction its next split will take from its shape: wider than tall ->
side by side, taller than wide -> top/bottom. Opening windows one after
another then halves the newest each time, alternating directions, like
bspwm/Hyprland's dwindle.

Left alone: floating and fullscreen windows, and tabbed/stacked
containers (their layout is the point). $mod+t still flips a split by
hand. Runs as spiral-tiling.service under dots-session.target.
"""
import json
import subprocess
import sys


def swaymsg(*args):
    return subprocess.run(["swaymsg", *args], capture_output=True, text=True).stdout


def focused_with_parent(node, parent=None):
    if node.get("focused"):
        return node, parent
    for child in node.get("nodes", []) + node.get("floating_nodes", []):
        found = focused_with_parent(child, node)
        if found:
            return found
    return None


def retile():
    found = focused_with_parent(json.loads(swaymsg("-t", "get_tree")))
    if not found:
        return
    win, parent = found
    if win.get("type") != "con" or win.get("nodes") or win.get("fullscreen_mode"):
        return
    if parent is None or parent.get("layout") in ("tabbed", "stacked"):
        return
    rect = win["rect"]
    want = "splith" if rect["width"] > rect["height"] else "splitv"
    if parent.get("layout") != want:
        swaymsg("split", "horizontal" if want == "splith" else "vertical")


def main():
    events = subprocess.Popen(["swaymsg", "-t", "subscribe", "-m", '["window"]'],
                              stdout=subprocess.PIPE, text=True)
    for line in events.stdout:
        try:
            change = json.loads(line).get("change")
        except ValueError:
            continue
        if change in ("focus", "new", "move", "floating"):
            retile()
    sys.exit(events.wait() or 1)   # sway went away: let systemd restart us


if __name__ == "__main__":
    main()
