# Toxic — generated by ~/.rice/bin/apply-theme from ~/.rice/themes/toxic.toml.
#
# Source of truth for ~/.config/swaylock/config, which is a symlink to this
# file via ~/.dots/swaylock (swaylock's config format has no include
# directive, so unlike most other ~/.rice apps this file *is* the config).
#
# Invoked via ~/.dots/scripts/.local/bin/lockscreen (grim + blur), bound to
# $mod+Escape in ~/.config/sway/config.

scaling=fill
color=#000000

ring-color=#1F4D0F
ring-clear-color=#CCFF00
ring-caps-lock-color=#CCFF00
ring-ver-color=#ADFF2F
ring-wrong-color=#FF3B30

inside-color=#000000
inside-clear-color=#000000
inside-caps-lock-color=#000000
inside-ver-color=#000000
inside-wrong-color=#000000

line-color=#000000
line-clear-color=#000000
line-caps-lock-color=#000000
line-ver-color=#000000
line-wrong-color=#000000

separator-color=#1F4D0F

text-color=#39FF14
text-clear-color=#D9FFD9
text-caps-lock-color=#CCFF00
text-ver-color=#ADFF2F
text-wrong-color=#FF3B30

key-hl-color=#39FF14
bs-hl-color=#FF3B30

indicator-radius=100
indicator-thickness=10

font=monospace
indicator-idle-visible
show-failed-attempts
