# {{name}} — generated by ~/.rice/bin/apply-theme from ~/.rice/themes/{{theme}}.toml.
# Sourced from ~/.dots/tmux/.config/tmux/tmux.conf via
# `source-file ~/.rice/tmux/theme.conf`.

set -g status-style "bg={{black}},fg={{neon}}"

set -g status-left-style "bg={{black}},fg={{neon}}"
set -g status-right-style "bg={{black}},fg={{acid}}"

setw -g window-status-style "bg={{black}},fg={{dim}}"
setw -g window-status-current-style "bg={{neon}},fg={{black}},bold"
setw -g window-status-activity-style "bg={{black}},fg={{red}}"
setw -g window-status-bell-style "bg={{black}},fg={{red}},bold"

set -g pane-border-style "fg={{deep}}"
set -g pane-active-border-style "fg={{neon}}"

set -g message-style "bg={{black}},fg={{neon}}"
set -g message-command-style "bg={{black}},fg={{acid}}"

set -g mode-style "bg={{neon}},fg={{black}}"

set -g display-panes-active-colour "{{neon}}"
set -g display-panes-colour "{{dim}}"

set -g clock-mode-colour "{{neon}}"
