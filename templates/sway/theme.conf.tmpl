# {{name}} — generated by ~/.rice/bin/apply-theme from ~/.rice/themes/{{theme}}.toml.
# Included from ~/.config/sway/config via `include ~/.rice/sway/theme.conf`.

# Gaps: small breathing room between windows and screen edges
gaps inner 6
gaps outer 4
# `gaps inner/outer` above only sets the default for workspaces created
# AFTER a reload — already-open workspaces keep their old gap value
# otherwise. Force it onto everything currently open too.
exec_always swaymsg 'gaps inner all set 6' && swaymsg 'gaps outer all set 4'

# class                     border      bg          text        indicator   child_border
client.focused              {{neon}}   {{black}}  {{neon}}   {{neon}}   {{neon}}
client.focused_inactive     {{dim}}    {{black}}  {{gray2}}  {{dim}}    {{dim}}
client.unfocused            {{deep}}   {{black}}  {{gray}}   {{deep}}   {{deep}}
client.urgent                {{red}}    {{black}}  {{red}}    {{red}}    {{red}}
client.placeholder          {{black}}  {{black}}  {{neon}}   {{black}}  {{black}}
client.background           {{black}}
