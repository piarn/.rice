# {{name}} — generated by ~/.rice/bin/apply-theme from ~/.rice/themes/{{theme}}.toml.
#
# Partial config — lazygit merges this over its own defaults, so only the
# theme section needs to be here.
#
# Source of truth for ~/.config/lazygit/config.yml, which is a symlink to
# this file via ~/.dots/lazygit (YAML has no include directive, so unlike
# most other ~/.rice apps this file *is* the config, not something sourced
# from it).

gui:
  theme:
    activeBorderColor:
      - "{{neon}}"
      - bold
    inactiveBorderColor:
      - "{{dim}}"
    searchingActiveBorderColor:
      - "{{acid}}"
      - bold
    optionsTextColor:
      - "{{cyan}}"
    selectedLineBgColor:
      - "{{dim}}"
    inactiveViewSelectedLineBgColor:
      - bold
    cherryPickedCommitFgColor:
      - "{{black}}"
    cherryPickedCommitBgColor:
      - "{{acid}}"
    markedBaseCommitFgColor:
      - "{{black}}"
    markedBaseCommitBgColor:
      - "{{amber}}"
    unstagedChangesColor:
      - "{{red}}"
    defaultFgColor:
      - "{{fg}}"
