# {{name}} — generated by ~/.rice/bin/apply-theme from ~/.rice/themes/{{theme}}.toml.
# Loaded via EZA_CONFIG_DIR=~/.rice/eza (must be named theme.yml), set from
# ~/.dots/fish/.config/fish/conf.d/00-rice.fish -> ~/.rice/eza/colors.fish.
#
# NOTE: eza applies LS_COLORS, then EZA_COLORS, *after* this file — so the
# ten classic file-kind codes (di, ln, ex, pi, so, bd, cd, or) get
# overridden by whatever LS_COLORS this system already exports (dircolors).
# ~/.rice/eza/colors.fish sets an EZA_COLORS that reclaims those specific
# codes to match the palette below; everything else here isn't touched by
# LS_COLORS/EZA_COLORS and applies as-is.

colourful: true

filekinds:
  normal:
    foreground: "{{fg}}"
  directory:
    foreground: "{{neon}}"
    is_bold: true
  symlink:
    foreground: "{{cyan}}"
    is_italic: true
  executable:
    foreground: "{{acid}}"
    is_bold: true
  pipe:
    foreground: "{{amber}}"
  socket:
    foreground: "{{magenta}}"
  block_device:
    foreground: "{{blue}}"
  char_device:
    foreground: "{{blue}}"
  special:
    foreground: "{{amber}}"
  mount_point:
    foreground: "{{neon}}"
    is_bold: true

perms:
  user_read:
    foreground: "{{acid}}"
  user_write:
    foreground: "{{red}}"
  user_execute_file:
    foreground: "{{neon}}"
    is_bold: true
  user_execute_other:
    foreground: "{{neon}}"
  group_read:
    foreground: "{{dim}}"
  group_write:
    foreground: "{{red}}"
  group_execute:
    foreground: "{{dim}}"
  other_read:
    foreground: "{{deep}}"
  other_write:
    foreground: "{{red}}"
  other_execute:
    foreground: "{{deep}}"
  special_user_file:
    foreground: "{{amber}}"
  special_other:
    foreground: "{{amber}}"
  attribute:
    foreground: "{{cyan}}"

size:
  number_byte:
    foreground: "{{fg}}"
  number_kilo:
    foreground: "{{acid}}"
  number_mega:
    foreground: "{{neon}}"
  number_giga:
    foreground: "{{amber}}"
  number_huge:
    foreground: "{{red}}"
    is_bold: true
  unit_byte:
    foreground: "{{gray}}"
  unit_kilo:
    foreground: "{{gray}}"
  unit_mega:
    foreground: "{{gray}}"
  unit_giga:
    foreground: "{{gray}}"
  unit_huge:
    foreground: "{{gray}}"

users:
  user_you:
    foreground: "{{neon}}"
    is_bold: true
  user_root:
    foreground: "{{red}}"
    is_bold: true
  user_other:
    foreground: "{{gray2}}"
  group_yours:
    foreground: "{{acid}}"
  group_other:
    foreground: "{{gray2}}"
  group_root:
    foreground: "{{red}}"

links:
  normal:
    foreground: "{{gray}}"
  multi_link_file:
    foreground: "{{amber}}"

git:
  new:
    foreground: "{{neon}}"
  modified:
    foreground: "{{amber}}"
  deleted:
    foreground: "{{red}}"
  renamed:
    foreground: "{{blue}}"
  typechange:
    foreground: "{{cyan}}"
  ignored:
    foreground: "{{gray}}"
  conflicted:
    foreground: "{{magenta}}"

git_repo:
  branch_main:
    foreground: "{{neon}}"
    is_bold: true
  branch_other:
    foreground: "{{acid}}"
  git_clean:
    foreground: "{{neon}}"
  git_dirty:
    foreground: "{{red}}"

file_type:
  image:
    foreground: "{{magenta}}"
  video:
    foreground: "{{magenta}}"
  music:
    foreground: "{{blue}}"
  lossless:
    foreground: "{{blue}}"
  crypto:
    foreground: "{{neon}}"
    is_bold: true
  document:
    foreground: "{{fg}}"
  compressed:
    foreground: "{{red}}"
  temp:
    foreground: "{{gray}}"
    is_dimmed: true
  compiled:
    foreground: "{{amber}}"
  build:
    foreground: "{{amber}}"
    is_bold: true
    is_underline: true
  source:
    foreground: "{{acid}}"

punctuation:
  foreground: "{{dim}}"
date:
  foreground: "{{acid}}"
inode:
  foreground: "{{gray}}"
blocks:
  foreground: "{{gray}}"
header:
  foreground: "{{neon}}"
  is_underline: true
octal:
  foreground: "{{cyan}}"
symlink_path:
  foreground: "{{cyan}}"
control_char:
  foreground: "{{red}}"
broken_symlink:
  foreground: "{{red}}"
  is_bold: true
broken_path_overlay:
  foreground: "{{red}}"
  is_dimmed: true
