# {{name}} — generated by ~/.rice/bin/apply-theme from ~/.rice/themes/{{theme}}/theme.toml.
# ~/.config/kdeglobals is a symlink straight to this file (stowed from
# ~/.dots/kde) — KConfig has no include directive, same deal as yazi/.
# Read by the KDE flatpaks (Dolphin, Gwenview, Ark, ...), which all ship
# with --filesystem=xdg-config/kdeglobals:ro and follow it here.
# Selection mirrors foot/nvim (dim behind fg); focus/hover is the accent.

[General]
ColorScheme={{theme}}

[Icons]
Theme=breeze-dark

[KDE]
contrast=4

[Colors:View]
BackgroundNormal={{black}}
BackgroundAlternate={{surface}}
ForegroundNormal={{fg}}
ForegroundInactive={{gray2}}
ForegroundActive={{neon}}
ForegroundLink={{blue}}
ForegroundVisited={{magenta}}
ForegroundNegative={{red}}
ForegroundNeutral={{amber}}
ForegroundPositive={{acid}}
DecorationFocus={{neon}}
DecorationHover={{neon}}

