# {{name}} — generated by ~/.rice/bin/apply-theme from ~/.rice/themes/{{theme}}/theme.toml.
#
# Source of truth for ~/.config/satty/config.toml, which is a symlink to
# this file via ~/.dots/satty (TOML has no include directive, so like
# ~/.rice/swaylock, this file *is* the config).
#
# Invoked by ~/.local/bin/screenshot-region ($mod+Shift+s): grim pipes the
# focused monitor into satty, opened fullscreen on the crop tool.
# Replaced swappy (~/.rice/README.md's old swappy/ entry) for a feature set
# closer to Flameshot/ShareX — crop, numbered markers, blur, highlight,
# undo/redo, per-key save/copy actions.

[general]
initial-tool = "brush"
copy-command = "wl-copy"
corner-roundness = 12
annotation-size-factor = 1
# Enter saves to file *and* clipboard, then exits — same one-step "annotate,
# hit enter, it's on your clipboard" flow ShareX/Flameshot give you.
actions-on-enter = ["save-to-file", "save-to-clipboard", "exit"]
actions-on-escape = ["exit"]
actions-on-right-click = ["save-to-clipboard"]
output-filename = "~/Pictures/Screenshots/%Y-%m-%d_%H-%M-%S.png"
default-hide-toolbars = false
primary-highlighter = "block"

[color-palette]
# Shown in the toolbar for quick selection — RRGGBBAA, alpha ff = opaque.
palette = [
    "{{neon}}FF",
    "{{red}}FF",
    "{{amber}}FF",
    "{{blue}}FF",
    "{{magenta}}FF",
    "{{cyan}}FF",
]

# Available as presets in the color picker.
custom = [
    "{{acid}}",
    "{{fg}}",
    "{{white}}",
]
