# {{name}} — generated by ~/.rice/bin/apply-theme from ~/.rice/themes/{{theme}}.toml.
# Included from ~/.config/foot/foot.ini via `include=~/.rice/foot/theme.ini`.

[cursor]
color={{black.hex}} {{neon.hex}}

[colors]
background={{black.hex}}
foreground={{fg.hex}}

selection-foreground={{fg.hex}}
selection-background={{dim.hex}}

# normal
regular0={{black.hex}}
regular1={{red.hex}}
regular2={{neon.hex}}
regular3={{amber.hex}}
regular4={{blue.hex}}
regular5={{magenta.hex}}
regular6={{cyan.hex}}
regular7={{fg.hex}}

# bright
bright0={{gray.hex}}
bright1={{red_bright.hex}}
bright2={{acid.hex}}
bright3={{amber_bright.hex}}
bright4={{blue_bright.hex}}
bright5={{magenta_bright.hex}}
bright6={{cyan_bright.hex}}
bright7={{white.hex}}
