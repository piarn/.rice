# {{name}} — generated by ~/.rice/bin/apply-theme from ~/.rice/themes/{{theme}}.toml.
#
# Partial config — lazydocker merges this over its own defaults, so only the
# theme section needs to be here.
#
# Source of truth for ~/.config/lazydocker/config.yml, which is a symlink to
# this file via ~/.dots/lazydocker (YAML has no include directive, so unlike
# most other ~/.rice apps this file *is* the config, not something sourced
# from it).

gui:
  theme:
    activeBorderColor:
      - "{{neon}}"
      - bold
    inactiveBorderColor:
      - "{{dim}}"
    selectedLineBgColor:
      - "{{dim}}"
    optionsTextColor:
      - "{{cyan}}"
