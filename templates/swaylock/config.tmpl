# {{name}} — generated by ~/.rice/bin/apply-theme from ~/.rice/themes/{{theme}}.toml.
#
# Source of truth for ~/.config/swaylock/config, which is a symlink to this
# file via ~/.dots/swaylock (swaylock's config format has no include
# directive, so unlike most other ~/.rice apps this file *is* the config).
#
# Invoked via ~/.dots/scripts/.local/bin/lockscreen (grim + blur), bound to
# $mod+Escape in ~/.config/sway/config.

scaling=fill
color={{black}}

ring-color={{dim}}
ring-clear-color={{amber}}
ring-caps-lock-color={{amber}}
ring-ver-color={{acid}}
ring-wrong-color={{red}}

inside-color={{black}}
inside-clear-color={{black}}
inside-caps-lock-color={{black}}
inside-ver-color={{black}}
inside-wrong-color={{black}}

line-color={{black}}
line-clear-color={{black}}
line-caps-lock-color={{black}}
line-ver-color={{black}}
line-wrong-color={{black}}

separator-color={{dim}}

text-color={{neon}}
text-clear-color={{fg}}
text-caps-lock-color={{amber}}
text-ver-color={{acid}}
text-wrong-color={{red}}

key-hl-color={{neon}}
bs-hl-color={{red}}

indicator-radius=100
indicator-thickness=10

font=monospace
indicator-idle-visible
show-failed-attempts
