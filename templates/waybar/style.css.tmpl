/* {{name}} — generated by ~/.rice/bin/apply-theme from ~/.rice/themes/{{theme}}.toml.
 * Imported from ~/.config/waybar/style.css via @import.
 */

* {
    font-family: monospace;
    font-size: 13px;
    min-height: 0;
}

window#waybar {
    background-color: {{black}};
    color: {{fg}};
}

#workspaces button {
    padding: 0 8px;
    background-color: transparent;
    color: {{gray}};
    border: none;
    border-radius: 0;
}

#workspaces button.focused {
    background-color: {{neon}};
    color: {{black}};
}

#workspaces button.urgent {
    background-color: {{red}};
    color: {{black}};
}

#mode {
    padding: 0 10px;
    background-color: {{dim}};
    color: {{black}};
}

#clock {
    color: {{neon}};
    font-weight: bold;
    padding: 0 12px;
}

#network,
#battery {
    padding: 0 10px;
    color: {{acid}};
}

#battery.warning {
    color: {{amber}};
}

#battery.critical {
    color: {{red}};
}

#network.disconnected {
    color: {{red}};
}
