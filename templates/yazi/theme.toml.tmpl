#:schema https://yazi-rs.github.io/schemas/theme.json
# {{name}} — generated by ~/.rice/bin/apply-theme from ~/.rice/themes/{{theme}}/theme.toml.
#
# Source of truth for ~/.config/yazi/theme.toml, which is a symlink to this
# file via ~/.dots/yazi (TOML has no include directive, so unlike the other
# ~/.rice apps this file *is* the config, not something sourced from it).
#
# Only touches UI chrome (borders, status bar, tabs, modes, markers, popups)
# and the broad filetype.rules mime groups — never the per-extension
# icon/brand-color tables ([icon].{globs,dirs,files,exts,conds}), same call
# as leaving code syntax highlighting alone in the nvim theme.

[flavor]
dark  = ""
light = ""

[app]
overall = {}

# : Manager

[mgr]
cwd = { fg = "{{neon}}" }

find_keyword  = { fg = "{{amber}}", bold = true, italic = true, underline = true }
find_position = { fg = "{{magenta}}", bg = "reset", bold = true, italic = true }

symlink_target = { italic = true }

marker_copied   = { fg = "{{acid}}", bg = "{{acid}}" }
marker_cut      = { fg = "{{red}}", bg = "{{red}}" }
marker_marked   = { fg = "{{cyan}}", bg = "{{cyan}}" }
marker_selected = { fg = "{{amber}}", bg = "{{amber}}" }
marker_symbol   = "│"

count_copied   = { fg = "{{black}}", bg = "{{neon}}" }
count_cut      = { fg = "{{black}}", bg = "{{red}}" }
count_selected = { fg = "{{black}}", bg = "{{amber}}" }

border_symbol = "│"
border_style  = { fg = "{{dim}}" }

syntect_theme = ""

# : Tabs

[tabs]
active   = { fg = "{{black}}", bg = "{{neon}}", bold = true }
inactive = { fg = "{{gray2}}", bg = "{{black}}" }

sep_inner = { open = "", close = "" }
sep_outer = { open = "", close = "" }

# : Mode

[mode]
normal_main = { fg = "{{black}}", bg = "{{neon}}", bold = true }
normal_alt  = { fg = "{{neon}}", bg = "{{black}}" }

select_main = { fg = "{{black}}", bg = "{{red}}", bold = true }
select_alt  = { fg = "{{red}}", bg = "{{black}}" }

unset_main = { fg = "{{black}}", bg = "{{amber}}", bold = true }
unset_alt  = { fg = "{{amber}}", bg = "{{black}}" }

# : Indicator of hovered file

[indicator]
parent  = { reversed = true }
current = { reversed = true }
preview = { underline = true }
padding = { open = "", close = "" }

# : Status bar

[status]
overall   = {}
sep_left  = { open = "", close = "" }
sep_right = { open = "", close = "" }

perm_sep   = { fg = "{{dim}}" }
perm_type  = { fg = "{{neon}}" }
perm_read  = { fg = "{{acid}}" }
perm_write = { fg = "{{red}}" }
perm_exec  = { fg = "{{cyan}}" }

progress_label  = { bold = true }
progress_normal = { fg = "{{neon}}", bg = "{{black}}" }
progress_error  = { fg = "{{amber}}", bg = "{{red}}" }

# : Which

[which]
cols            = 3
mask            = { bg = "{{black}}" }
cand            = { fg = "{{neon}}" }
rest            = { fg = "{{dim}}" }
desc            = { fg = "{{magenta}}" }
separator       = "  "
separator_style = { fg = "{{dim}}" }

# : Confirmation

[confirm]
border     = { fg = "{{neon}}" }
title      = { fg = "{{neon}}" }
body       = {}
list       = {}
btn_yes    = { reversed = true }
btn_no     = {}
btn_labels = [ "  [Y]es  ", "  (N)o  " ]

# : Spotter

[spot]
border = { fg = "{{neon}}" }
title  = { fg = "{{neon}}" }

tbl_col  = { fg = "{{acid}}" }
tbl_cell = { fg = "{{amber}}", reversed = true }

# : Notification

[notify]
title_info  = { fg = "{{neon}}" }
title_warn  = { fg = "{{amber}}" }
title_error = { fg = "{{red}}" }

icon_info  = ""
icon_warn  = ""
icon_error = ""

# : Picker

[pick]
border   = { fg = "{{neon}}" }
active   = { fg = "{{acid}}", bold = true }
inactive = {}

# : Input

[input]
border   = { fg = "{{neon}}" }
title    = {}
value    = {}
selected = { reversed = true }

# : Completion

[cmp]
border   = { fg = "{{neon}}" }
active   = { reversed = true }
inactive = {}

icon_file    = ""
icon_folder  = ""
icon_command = ""

# : Task manager

[tasks]
border  = { fg = "{{neon}}" }
title   = {}
hovered = { fg = "{{acid}}", bold = true }

# : Help menu

[help]
on      = { fg = "{{cyan}}" }
run     = { fg = "{{magenta}}" }
desc    = {}
hovered = { reversed = true, bold = true }
footer  = { fg = "{{black}}", bg = "{{neon}}" }

# : File-specific styles (broad mime groups only — see note at top)

[filetype]
rules = [
	{ mime = "image/*", fg = "{{magenta}}" },
	{ mime = "{audio,video}/*", fg = "{{magenta}}" },
	{ mime = "application/{zip,rar,7z*,tar,gzip,xz,zstd,bzip*,lzma,compress,archive,cpio,arj,xar,ms-cab*}", fg = "{{red}}" },
	{ mime = "application/{pdf,doc,rtf}", fg = "{{cyan}}" },
	{ mime = "vfs/{absent,stale}", fg = "{{gray}}" },
	{ url = "*", is = "orphan", bg = "{{red}}" },
	{ url = "*", is = "exec"  , fg = "{{neon}}" },
	{ url = "*", is = "dummy", bg = "{{red}}" },
	{ url = "*/", is = "dummy", bg = "{{red}}" },
	{ url = "*/", fg = "{{neon}}" },
]
