/* {{name}} — generated by ~/.rice/bin/apply-theme from ~/.rice/themes/{{theme}}.toml.
 * Imported from ~/.config/wofi/style.css via @import.
 */

window {
    background-color: {{black}};
    border: 2px solid {{neon}};
    border-radius: 6px;
    font-family: monospace;
    font-size: 14px;
    color: {{fg}};
}

#input {
    background-color: {{black}};
    border: 1px solid {{dim}};
    color: {{neon}};
    margin: 8px;
    padding: 6px;
}

#input:focus {
    border: 1px solid {{neon}};
}

#inner-box {
    background-color: {{black}};
}

#outer-box {
    background-color: {{black}};
    padding: 4px;
}

#scroll {
    background-color: {{black}};
}

#text {
    color: {{fg}};
}

#entry {
    padding: 4px;
}

#entry:selected {
    background-color: {{dim}};
    border-radius: 4px;
}

#entry:selected #text {
    color: {{neon}};
}
