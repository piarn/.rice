#!/usr/bin/env python3
"""Render every ~/.rice/<app>/... theme file from a single palette file.

Usage:
    apply-theme                 # re-render the currently active theme
    apply-theme <name>          # switch to ~/.rice/themes/<name>/theme.toml, render it,
                                 # and remember it as the active theme
    apply-theme <name> --dry-run   # show what would change, write nothing

Templates live under ~/.rice/templates/<app>/<file>.tmpl and use:
    {{token}}        the color as "#RRGGBB"
    {{token.hex}}     the color as "rrggbb", no '#' (lowercase)
    {{token.rgb}}     the color as decimal "R;G;B" (for ANSI SGR strings)
    {{name}}          the theme's display name (e.g. "Toxic")
    {{theme}}         the theme's directory name (e.g. "toxic")

Each template renders to ~/.rice/<same relative path, minus ".tmpl">.

Wallpapers aren't templated — drop an image at
~/.rice/themes/<theme>/wallpaper.<ext> and it gets copied verbatim to
~/.rice/wallpaper.png (the fixed path sway's config points at), pushed
live to every output via `swaymsg` if sway is running.
"""

import argparse
import os
import re
import subprocess
import sys
import tomllib
from pathlib import Path

RICE = Path.home() / ".rice"
THEMES = RICE / "themes"
TEMPLATES = RICE / "templates"
CURRENT = THEMES / "current"
WALLPAPER_DEST = RICE / "wallpaper.png"
# themes/current is gitignored (it's per-machine state, not something a
# theme switch should ever show up as a repo diff) — a fresh clone has none,
# so fall back to this rather than making every new machine's first run
# require an explicit `apply-theme <name>`.
DEFAULT_THEME = "toxic"
# `qs` links against quickshell's private Qt 6.8 ABI, which system Qt
# packages don't reliably provide (e.g. Ubuntu 24.04's is 6.4.2) — mirrors
# sway config's `$qs` variable (`env LD_LIBRARY_PATH=... qs`), since a plain
# `qs` invocation here would only work by coincidence, on a machine whose
# system Qt already happens to be >=6.8.
QUICKSHELL_QT_LIB_DIR = Path.home() / "Qt" / "6.8.0" / "gcc_64" / "lib"

TOKEN_RE = re.compile(r"\{\{\s*([a-zA-Z0-9_]+)(?:\.(hex|rgb))?\s*\}\}")


def load_theme(name: str) -> dict:
    path = THEMES / name / "theme.toml"
    if not path.exists():
        sys.exit(f"error: no such theme file: {path}")
    with path.open("rb") as f:
        data = tomllib.load(f)
    if "colors" not in data:
        sys.exit(f"error: {path} has no [colors] table")
    return data


def hex_to_rgb(hex_color: str) -> tuple[int, int, int]:
    h = hex_color.lstrip("#")
    return int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)


def render(text: str, theme: dict, theme_name: str) -> str:
    colors = theme["colors"]

    def repl(m: re.Match) -> str:
        token, form = m.group(1), m.group(2)
        if token == "name":
            return theme.get("name", theme_name)
        if token == "theme":
            return theme_name
        if token not in colors:
            raise KeyError(f"unknown color token {{{{{token}}}}} (theme has no '{token}')")
        value = colors[token]
        if form == "hex":
            return value.lstrip("#").lower()
        if form == "rgb":
            r, g, b = hex_to_rgb(value)
            return f"{r};{g};{b}"
        return value

    return TOKEN_RE.sub(repl, text)


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("theme", nargs="?", help="theme name (e.g. toxic); defaults to the current theme")
    parser.add_argument("--dry-run", action="store_true", help="show what would change, write nothing")
    args = parser.parse_args()

    if args.theme:
        theme_name = args.theme
    elif CURRENT.exists():
        theme_name = CURRENT.read_text().strip()
    else:
        theme_name = DEFAULT_THEME

    theme = load_theme(theme_name)

    template_files = sorted(TEMPLATES.rglob("*.tmpl"))
    if not template_files:
        sys.exit(f"error: no templates found under {TEMPLATES}")

    # Render everything first and only start writing once every template has
    # proven renderable — otherwise a theme missing one token (e.g. a
    # half-finished new theme file) would leave some apps on the old theme
    # and others on the new one.
    renders = []
    for tmpl in template_files:
        rel = tmpl.relative_to(TEMPLATES)
        dest = RICE / rel.with_suffix("")  # strip .tmpl
        try:
            rendered = render(tmpl.read_text(), theme, theme_name)
        except KeyError as e:
            sys.exit(f"error rendering {tmpl}: {e}")
        renders.append((dest, rendered))

    changed = []
    for dest, rendered in renders:
        existing = dest.read_text() if dest.exists() else None
        if existing == rendered:
            continue
        changed.append(dest.relative_to(RICE))
        if not args.dry_run:
            dest.parent.mkdir(parents=True, exist_ok=True)
            dest.write_text(rendered)

    # Wallpapers aren't templated (they're images, not text) — each theme
    # just drops a file at themes/<theme>/wallpaper.<ext> and it gets copied
    # verbatim to the fixed path sway/quickshell actually reference.
    theme_dir = THEMES / theme_name
    wallpaper_src = next(iter(sorted(theme_dir.glob("wallpaper.*"))), None)
    if wallpaper_src:
        new_bytes = wallpaper_src.read_bytes()
        existing_bytes = WALLPAPER_DEST.read_bytes() if WALLPAPER_DEST.exists() else None
        if new_bytes != existing_bytes:
            changed.append(WALLPAPER_DEST.relative_to(RICE))
            if not args.dry_run:
                WALLPAPER_DEST.write_bytes(new_bytes)
    else:
        print(f"warning: no wallpaper found at {theme_dir}/wallpaper.* — leaving wallpaper.png as-is", file=sys.stderr)

    if not args.dry_run:
        THEMES.mkdir(parents=True, exist_ok=True)
        CURRENT.write_text(theme_name + "\n")

    verb = "would change" if args.dry_run else "wrote"
    if changed:
        print(f"{verb} {len(changed)} file(s) for theme '{theme_name}':")
        for f in changed:
            print(f"  {f}")
    else:
        print(f"nothing to do — all files already match theme '{theme_name}'")

    if not args.dry_run and changed:
        reload_running_apps(changed)


def reload_running_apps(changed: list) -> None:
    """Nudge apps that cache their config in memory so the new theme is
    visible without a manual restart. Nvim's autocmd already re-applies on
    ColorScheme events; foot/kitty read their theme file live (kitty) or on
    next launch (foot) — cursor color is intentionally not themed (always
    white, see templates/{foot,kitty,nvim}/...), so there's nothing to nudge
    for either of them.
    """
    if any(str(f) == "wallpaper.png" for f in changed):
        reload_wallpaper()

    # quickshell's Colors.qml singleton is loaded once at startup via
    # QML2_IMPORT_PATH and isn't file-watched like the rest of its config,
    # so a plain `swaymsg reload` alone won't pick up new colors — kill the
    # running instance first so the exec_always respawn (still `-n`, so it
    # only fires because nothing's running anymore) loads it fresh.
    if any(str(f).startswith("quickshell/") for f in changed):
        reload_quickshell()

    # Sway only re-reads its config (border colors, gaps) on an explicit
    # reload — the theme.conf include changing on disk doesn't do anything
    # by itself.
    if any(str(f).startswith("sway/") or str(f).startswith("quickshell/") for f in changed):
        reload_sway()

    if any(str(f) == "fish/colors.fish" for f in changed):
        reload_fish()

    if not any(str(f).startswith("tmux/") for f in changed):
        return
    # no -x: tmux renames its own processes to "tmux: client"/"tmux: server"
    if subprocess.run(["pgrep", "tmux"], capture_output=True).returncode != 0:
        return
    tmux_conf = Path.home() / ".config" / "tmux" / "tmux.conf"
    if not tmux_conf.exists():
        return
    result = subprocess.run(
        ["tmux", "source-file", str(tmux_conf)], capture_output=True, text=True
    )
    if result.returncode == 0:
        print("reloaded tmux.conf in the running tmux server")
    else:
        print(f"warning: tmux reload failed: {result.stderr.strip()}", file=sys.stderr)


def reload_fish() -> None:
    """rice_color_dir is a universal variable (set -U): fish broadcasts a
    change to every running fish session as soon as one process sets it,
    so a throwaway `fish -c` re-sourcing colors.fish is enough to update
    the prompt color in every already-open shell, no restart needed."""
    if subprocess.run(["pgrep", "-x", "fish"], capture_output=True).returncode != 0:
        return
    fish_colors = RICE / "fish" / "colors.fish"
    result = subprocess.run(
        ["fish", "-c", f"source {fish_colors}"], capture_output=True, text=True
    )
    if result.returncode == 0:
        print("pushed prompt color to running fish sessions")
    else:
        print(f"warning: fish reload failed: {result.stderr.strip()}", file=sys.stderr)


def reload_sway() -> None:
    """Reload sway's config so border colors and gaps (theme.conf) and a
    freshly-killed quickshell instance (exec_always) pick up the new
    theme immediately, instead of waiting for the next manual reload."""
    if not os.environ.get("SWAYSOCK"):
        print("warning: SWAYSOCK not set in this process's environment — "
              "skipping swaymsg reload (border colors/gaps and any killed "
              "quickshell instance won't be picked back up)", file=sys.stderr)
        return
    result = subprocess.run(["swaymsg", "reload"], capture_output=True, text=True)
    if result.returncode == 0:
        print("reloaded sway config")
    else:
        print(f"warning: swaymsg reload failed: {result.stderr.strip()}", file=sys.stderr)


def reload_quickshell() -> None:
    """Kill the running quickshell instance so sway's `exec_always ... -n`
    line (which only spawns when none is running) launches a fresh one
    that re-imports Colors.qml. Left to `reload_sway()` to actually
    trigger that respawn."""
    if subprocess.run(["pgrep", "-x", "quickshell"], capture_output=True).returncode != 0:
        print("warning: no running quickshell instance found — skipping kill "
              "(it'll pick up the new theme on next launch)", file=sys.stderr)
        return
    if not os.environ.get("SWAYSOCK"):
        print("warning: SWAYSOCK not set in this process's environment — "
              "skipping quickshell kill, since sway's exec_always respawn "
              "(reload_sway) won't be able to bring it back", file=sys.stderr)
        return
    if not QUICKSHELL_QT_LIB_DIR.is_dir():
        print(f"warning: {QUICKSHELL_QT_LIB_DIR} not found — qs needs this "
              "Qt 6.8 build to run at all (see sway config's $qs); skipping "
              "quickshell kill", file=sys.stderr)
        return
    env = os.environ | {"LD_LIBRARY_PATH": str(QUICKSHELL_QT_LIB_DIR)}
    result = subprocess.run(["qs", "kill", "-n"], capture_output=True, text=True, env=env)
    if result.returncode == 0:
        print("killed quickshell (will respawn on sway reload)")
    else:
        print(f"warning: qs kill failed: {result.stderr.strip()}", file=sys.stderr)


def reload_wallpaper() -> None:
    """Push the new wallpaper.png to every output right away via sway IPC,
    rather than waiting for the next full `sway reload` (which the wallpaper
    line in ~/.config/sway/config would otherwise need to pick it up)."""
    if not os.environ.get("SWAYSOCK"):
        return
    result = subprocess.run(
        ["swaymsg", "output", "*", "bg", str(WALLPAPER_DEST), "fill"],
        capture_output=True, text=True,
    )
    if result.returncode == 0:
        print("reloaded wallpaper on all outputs")
    else:
        print(f"warning: swaymsg wallpaper reload failed: {result.stderr.strip()}", file=sys.stderr)


if __name__ == "__main__":
    main()
