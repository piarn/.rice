#!/usr/bin/env python3
"""Switch sway's screen (output) layout between saved profiles.

Usage:
    apply-layout                # re-apply the currently active layout
    apply-layout <name>         # switch to ~/.rice/layouts/<name>.conf,
                                 # apply it live, and remember it as active
    apply-layout --auto         # detect connected outputs and switch to
                                 # whichever profile matches them
    apply-layout --list         # list available layouts, marking the active one

Layout profiles live in ~/.rice/layouts/<name>.conf as plain sway `output`
config, with a `# requires: ID-1,ID-2,...` comment naming the outputs
that must be connected for `--auto` to pick it. Each ID is either a
connector name (eDP-1 — stable for a built-in panel) or a
"<make> <model> <serial>" string (sway accepts this as an output
criteria too) — prefer the latter for anything external: Thunderbolt/
DP-MST reconnects renumber connectors (DP-5 can become DP-7 on a
replug), but make/model/serial survives it. The active profile is
copied to ~/.rice/sway/outputs.conf, which ~/.config/sway/config
includes, and its name is recorded in ~/.rice/layouts/current.

`--auto` picks the profile whose `requires:` set is fully connected and
has the most outputs (most specific match wins) — so a profile requiring
just eDP-1 only kicks in when nothing more specific fits. See
~/.rice/bin/layout-watch for the daemon that calls this on dock/undock.

A layout picked by name (not --auto) is "pinned": ~/.rice/layouts/current
gets a second line, `manual`. layout-watch calls --auto on every sway
output event, including the one a layout switch itself causes (e.g.
disabling eDP-1) — without pinning, that self-triggered event would
immediately auto-match a more specific profile (like home-office, which
still sees eDP-1 as connected even with the lid closed) and silently
revert a manual choice like `docked`. --auto leaves a pinned layout alone
as long as its own `requires:` are still satisfied; it only overrides
once the connected outputs actually stop matching it.

Gaps and colors are theme concerns, not layout ones — see ~/.rice/sway/theme.conf.
"""

import argparse
import json
import re
import subprocess
import sys
from pathlib import Path

RICE = Path.home() / ".rice"
LAYOUTS = RICE / "layouts"
CURRENT = LAYOUTS / "current"
OUTPUTS_CONF = RICE / "sway" / "outputs.conf"

REQUIRES_RE = re.compile(r"^#\s*requires:\s*(.+)$", re.IGNORECASE)


def available() -> list[str]:
    return sorted(p.stem for p in LAYOUTS.glob("*.conf"))


def active_name() -> str | None:
    if not CURRENT.exists():
        return None
    lines = CURRENT.read_text().splitlines()
    return lines[0].strip() if lines else None


def active_is_pinned() -> bool:
    if not CURRENT.exists():
        return False
    lines = CURRENT.read_text().splitlines()
    return len(lines) > 1 and lines[1].strip() == "manual"


def requires_for(name: str) -> set[str]:
    for line in (LAYOUTS / f"{name}.conf").read_text().splitlines():
        m = REQUIRES_RE.match(line.strip())
        if m:
            return {x.strip() for x in m.group(1).split(",") if x.strip()}
    return set()


def connected_outputs() -> set[str]:
    """Every ID a connected output can be matched by: its connector name
    (e.g. DP-7) and, when available, its "<make> <model> <serial>" string
    — the latter is what survives a Thunderbolt/DP-MST reconnect."""
    result = subprocess.run(
        ["swaymsg", "-t", "get_outputs"], capture_output=True, text=True, check=True
    )
    idents: set[str] = set()
    for o in json.loads(result.stdout):
        idents.add(o["name"])
        make, model, serial = o.get("make"), o.get("model"), o.get("serial")
        if make and model and serial:
            idents.add(f"{make} {model} {serial}")
    return idents


def best_match(connected: set[str]) -> str | None:
    candidates = []
    for name in available():
        req = requires_for(name)
        if req and req <= connected:
            candidates.append((len(req), name))
    if not candidates:
        return None
    candidates.sort(reverse=True)
    return candidates[0][1]


def apply(name: str, *, pinned: bool) -> None:
    path = LAYOUTS / f"{name}.conf"
    if not path.exists():
        sys.exit(f"error: no such layout: {path}\navailable: {', '.join(available())}")

    text = path.read_text()
    OUTPUTS_CONF.write_text(
        f"# generated by ~/.rice/bin/apply-layout from {path}\n" + text
    )
    CURRENT.write_text(name + "\n" + ("manual\n" if pinned else ""))

    subprocess.run(["swaymsg", "reload"], check=True)
    print(f"layout: {name}" + (" (pinned)" if pinned else ""))


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("name", nargs="?", help="layout to switch to")
    parser.add_argument("--auto", action="store_true", help="auto-detect connected outputs and switch")
    parser.add_argument("--list", action="store_true", help="list available layouts")
    args = parser.parse_args()

    if args.list:
        current = active_name()
        for name in available():
            marker = "*" if name == current else " "
            print(f"{marker} {name}")
        return

    if args.auto:
        connected = connected_outputs()
        current = active_name()
        if current is not None and active_is_pinned() and requires_for(current) <= connected:
            print(f"layout: {current} (pinned, unchanged)")
            return
        name = best_match(connected)
        if name is None:
            sys.exit(f"error: no layout matches connected outputs: {', '.join(sorted(connected))}")
        if name == current:
            print(f"layout: {name} (unchanged)")
            return
        apply(name, pinned=False)
        return

    name = args.name
    if name is None:
        name = active_name()
        if name is None:
            sys.exit("error: no active layout yet — pass a name, e.g. apply-layout home-office")
        apply(name, pinned=active_is_pinned())
        return
    apply(name, pinned=True)


if __name__ == "__main__":
    main()
