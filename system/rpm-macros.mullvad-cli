# Mullvad's app (Electron) is not installed: only its daemon and CLI are used.
# rpm skips these paths on every install and upgrade of mullvad-vpn.
%_netsharedpath /opt/Mullvad VPN/LICENSE.electron.txt:/opt/Mullvad VPN/LICENSES.chromium.html:/opt/Mullvad VPN/chrome-sandbox:/opt/Mullvad VPN/chrome_100_percent.pak:/opt/Mullvad VPN/chrome_200_percent.pak:/opt/Mullvad VPN/chrome_crashpad_handler:/opt/Mullvad VPN/icudtl.dat:/opt/Mullvad VPN/libEGL.so:/opt/Mullvad VPN/libGLESv2.so:/opt/Mullvad VPN/libffmpeg.so:/opt/Mullvad VPN/libvk_swiftshader.so:/opt/Mullvad VPN/libvulkan.so.1:/opt/Mullvad VPN/locales:/opt/Mullvad VPN/mullvad-gui:/opt/Mullvad VPN/mullvad-vpn:/opt/Mullvad VPN/resources.pak:/opt/Mullvad VPN/snapshot_blob.bin:/opt/Mullvad VPN/v8_context_snapshot.bin:/opt/Mullvad VPN/vk_swiftshader_icd.json:/opt/Mullvad VPN/resources/app.asar:/usr/share/applications/mullvad-vpn.desktop:/usr/share/icons/hicolor/16x16/apps/mullvad-vpn.png:/usr/share/icons/hicolor/24x24/apps/mullvad-vpn.png:/usr/share/icons/hicolor/32x32/apps/mullvad-vpn.png:/usr/share/icons/hicolor/48x48/apps/mullvad-vpn.png:/usr/share/icons/hicolor/64x64/apps/mullvad-vpn.png:/usr/share/icons/hicolor/128x128/apps/mullvad-vpn.png:/usr/share/icons/hicolor/256x256/apps/mullvad-vpn.png:/usr/share/icons/hicolor/512x512/apps/mullvad-vpn.png
