__pycache__

# Rendered output of apply-theme (bin/apply-theme, templates/**/*.tmpl) and
# the "which theme is active" pointer — this is per-machine build state, not
# source. Regenerated by apply-theme on every clone/pull (see install.sh and
# DEFAULT_THEME in apply-theme), so switching themes locally should never
# show up as a repo diff. The actual source of truth is themes/*/theme.toml
# and templates/**/*.tmpl, both of which stay tracked.
