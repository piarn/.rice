/fzf/colors.fish
/kitty/theme.conf
/lazydocker/config.yml
/lazygit/config.yml
/nvim/theme.lua
/quickshell/Colors.qml
/satty/config.toml
/sway/theme.conf
/tmux/theme.conf
/yazi/theme.toml
